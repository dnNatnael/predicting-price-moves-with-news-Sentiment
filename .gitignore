# -------------------------
#  Python virtual environment
# -------------------------
venv/
ENV/
env/
.venv/

# -------------------------
#  Python cache files
# -------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# -------------------------
#  Jupyter Notebook checkpoints
# -------------------------
.ipynb_checkpoints/

# -------------------------
#  VSCode settings
# -------------------------
.vscode/

# -------------------------
#  Logs and temp files
# -------------------------
*.log
*.tmp
*.temp

# -------------------------
#  OS generated files
# -------------------------
.DS_Store
Thumbs.db

# -------------------------
#  Environment/config files
# -------------------------
*.env
.env.*
*.ini

# -------------------------
#  Data files (avoid pushing large datasets)
# -------------------------
*.xlsx
*.parquet

# Keep sample stock data in data/
!data/
!data/*.csv

# Exclude 313MB raw dataset (exceeds GitHub 100MB limit)
data/raw_analyst_ratings.csv

# Keep precomputed output datasets & metrics
!output/data/
!output/data/*.csv
!output/data/*.json

# Exclude large intermediate output files (>10MB)
output/data/articles_with_sentiment.csv
output/data/articles_with_topics.csv

# -------------------------
#  Model artifacts
# -------------------------
models/
*.h5
*.pkl

# Keep trained lightweight model binaries for dashboard inference
!output/models/
!output/models/*.joblib
!output/models/*.json

# -------------------------
#  Build / packaging
# -------------------------
dist/
build/
*.egg-info/

# -------------------------
#  Misc
# -------------------------
*.sqlite
*.db

# -------------------------
#  Misc
# -------------------------
node_modules/